        {
          "name": "registration before deed -> deficiency",
          "expect": "deficiency",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [
              {
                "type": "trust_deed",
                "fields": {
                  "issue_date": "2010-05-20"
                }
              },
              {
                "type": "registration_certificate",
                "fields": {
                  "issue_date": "2009-01-15"
                }
              }
            ]
          }
        },
        {
          "name": "ordered -> pass",
          "expect": "pass",
          "ctx": {
            "submission_date": "2026-10-23",
