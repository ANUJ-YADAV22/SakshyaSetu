      "title": "Trust deed predates registration",
      "family": "validity",
      "approval": "approved",
      "severity": "major",
      "tier": "A",
      "message_template": "Date order broken: {earlier} ({d1}) must not be later than {later} ({d2}).",
      "check": {
        "type": "date_order",
        "params": {
          "earlier": "trust_deed.issue_date",
          "later": "registration_certificate.issue_date",
          "earlier_label": "trust deed",
          "later_label": "registration certificate"
        }
      },
