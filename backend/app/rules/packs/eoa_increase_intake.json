      },
      "tests": [
        {
          "name": "pending -> needs_review",
          "expect": "needs_review",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [],
            "declared": {
              "proposed_intake": 120
            },
            "records": {
              "pending_inquiry": true
            }
          }
        },
        {
          "name": "none -> pass",
          "expect": "pass",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [],
            "declared": {
              "proposed_intake": 120
            },
            "records": {
              "pending_inquiry": false
            }
          }
        }
      ]
    },
