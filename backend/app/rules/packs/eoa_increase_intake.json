      },
      "tests": [
        {
          "name": "expired -> deficiency",
          "expect": "deficiency",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [
              {
                "type": "fire_noc",
                "fields": {
                  "validity_end": "30/06/2024"
                }
              }
            ]
          }
        },
        {
          "name": "valid -> pass",
          "expect": "pass",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [
              {
                "type": "fire_noc",
                "fields": {
                  "validity_end": "30/06/2030"
                }
              }
            ]
          }
        },
        {
          "name": "nearing expiry -> needs_review",
          "expect": "needs_review",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [
              {
                "type": "fire_noc",
                "fields": {
                  "validity_end": "2026-11-20"
