      "rule_id": "APH-2.6-RATIO-001",
      "clause": "Cl. 2.6 (faculty ratio)",
      "clause_confirmed": false,
      "title": "Student-faculty ratio within configured maximum",
      "family": "quantitative",
      "approval": "draft",
      "severity": "major",
      "tier": "B",
      "message_template": "Students per faculty {ratio} exceeds configured maximum {max}.",
      "check": {
        "type": "ratio_max",
        "params": {
          "students_key": "total_students",
          "faculty_key": "faculty_count",
          "max_ratio": 20,
          "parameters_verified": false
        }
      },
      "notes": "DRAFT: numeric threshold NOT yet confirmed against the authorised APH. Engine skips draft rules and reports them as not checked.",
      "tests": [
        {
          "name": "above max -> deficiency",
          "expect": "deficiency",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [],
            "declared": {
              "total_students": 600,
              "faculty_count": 20
            }
          }
        }
      ]
    },
    {
      "rule_id": "APH-2.6-FAC-001",
      "clause": "Cl. 2.6 (faculty requirement)",
      "clause_confirmed": false,
      "title": "Listed faculty meets the computed requirement for the proposed intake",
      "family": "quantitative",
      "approval": "draft",
      "severity": "major",
      "tier": "B",
      "message_template": "Listed faculty {listed} is below the computed requirement {need} (= ceil({intake} x {years} / {ratio})); short by {short}.",
      "check": {
        "type": "faculty_required",
        "params": {
          "intake_key": "proposed_intake",
          "faculty_key": "faculty_count",
          "program_years": 4,
          "faculty_ratio": 20,
          "parameters_verified": false
        }
      },
      "notes": "DRAFT: programme years and students-per-faculty are example parameters, not confirmed against the authorised APH. Approve through the maker-checker flow after expert confirmation.",
      "tests": [
        {
          "name": "enough faculty -> pass",
          "expect": "pass",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [],
            "declared": {
              "proposed_intake": 120,
              "faculty_count": 24
            }
          }
        },
        {
          "name": "short of requirement -> deficiency",
          "expect": "deficiency",
