    {
      "rule_id": "APH-2.6-REC-001",
      "clause": "Cl. 2.6 (comparison with approved intake)",
      "clause_confirmed": false,
      "title": "Proposed intake compared with approved intake",
      "family": "record",
      "approval": "approved",
      "severity": "info",
      "tier": "A",
      "message_template": "Intake change recorded for reviewer.",
      "check": {
        "type": "declared_vs_record",
        "params": {
          "declared_key": "proposed_intake",
          "record_key": "approved_intake",
          "op": "diff",
          "label": "intake"
        }
      },
      "tests": [
        {
          "name": "recorded -> pass",
          "expect": "pass",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [],
            "declared": {
              "proposed_intake": 120
            },
            "records": {
              "approved_intake": 60
            }
          }
        }
      ]
    },
    {
      "rule_id": "APH-2.6-REC-002",
      "clause": "Cl. 2.6 (pending-inquiry check)",
      "clause_confirmed": false,
      "title": "No pending inquiry on institution record",
      "family": "record",
      "approval": "approved",
      "severity": "major",
      "tier": "B",
      "message_template": "Institution record shows a pending inquiry ({label}); reviewer must confirm before proceeding.",
