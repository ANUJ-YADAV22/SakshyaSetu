      "family": "validity",
      "approval": "approved",
      "severity": "major",
      "tier": "A",
      "message_template": "{label} expired: validity ended {date}, before submission date {submission}.",
      "check": {
        "type": "validity",
        "params": {
          "doc_type": "fire_noc",
          "label": "Fire certificate",
          "warn_days": 60
