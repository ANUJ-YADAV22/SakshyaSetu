              }
            ]
          }
        },
        {
          "name": "ambiguous with differing outcome -> needs_review",
          "expect": "needs_review",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [
              {
                "type": "fire_noc",
                "fields": {
                  "validity_end": "05/12/2026"
                }
              }
            ]
          }
        },
        {
          "name": "low confidence -> needs_review",
          "expect": "needs_review",
          "ctx": {
            "submission_date": "2026-10-23",
            "docs": [
              {
                "type": "fire_noc",
                "confidence": 0.4,
                "fields": {
                  "validity_end": "30/06/2030"
                }
              }
            ]
          }
        }
      ]
